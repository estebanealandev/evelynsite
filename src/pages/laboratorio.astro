---
// Página interna de prototipos. No aparece en el sitemap, está sin indexar y se retirará al elegir un concepto.
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import '../styles/lab.css';
---
<Base noindex title="Laboratorio 3D" description="Página interna para comparar prototipos 3D.">
  <section class="lab on-dark" data-lab>
    <div class="lab__stage">
      <canvas aria-hidden="true"></canvas>
      <div class="wrap lab__content">
        <h1 class="lab__title">Protegemos lo que <em>más</em> importa.</h1>
        <div class="lab__foot">
          <p>Brindamos orientación y acompañamiento jurídico en asuntos de derecho de familia, con un enfoque humano, estratégico y comprometido con la protección de sus derechos.</p>
          <div class="btn-row">
            <a class="btn" href="/agendar-consulta">Agendar una consulta</a>
            <a class="btn btn-outline" href="/servicios">Conocer nuestros servicios</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="chapter bg-ivory">
    <div class="wrap">
      <h2 class="statement">La asesoría adecuada puede marcar una diferencia en una etapa <em>decisiva.</em></h2>
    </div>
  </section>

  <div class="lab-nota" data-nota role="status"></div>
  <div class="lab-panel" role="group" aria-label="Controles del laboratorio">
    <button type="button" data-concepto="crece" aria-pressed="true" aria-label="1 Crecer">1<span class="lab-largo"> Crecer</span></button>
    <button type="button" data-concepto="particulas" aria-pressed="false" aria-label="2 Partículas">2<span class="lab-largo"> Partículas</span></button>
    <button type="button" data-concepto="sombra" aria-pressed="false" aria-label="3 Sombra">3<span class="lab-largo"> Sombra</span></button>
    <button type="button" data-pausa aria-pressed="false">Pausar</button>
    <span data-fps aria-hidden="true">– fps</span>
  </div>
  <script>
    import '../scripts/arboles/laboratorio.ts';
  </script>
</Base>
