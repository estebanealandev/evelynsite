---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import PostsSection from '../components/sections/PostsSection.astro';
import Cta from '../components/sections/Cta.astro';
import { principios } from '../lib/institucional';

const posts = (await getCollection('articulos')).filter(a => a.data.destacado).slice(3, 6);
const etica = [
  { t: 'Qué dice el Código de Deberes', d: 'El Código de Deberes Jurídicos, Morales y Éticos del Profesional en Derecho es de aplicación forzosa para las personas abogadas inscritas en el Colegio de Abogados (artículo 1). Regula, entre otros puntos, la relación con la clientela y la publicidad. Su artículo 30 pide moderación y evitar el autoelogio o la información que induzca a error.' },
  { t: 'Análisis de cada asunto', d: 'La misma norma puede producir efectos distintos según los hechos, la prueba y las resoluciones ya dictadas. Sin esos elementos no puede sugerirse una vía.' },
  { t: 'Fecha de las normas', d: 'El Código Procesal de Familia rige desde el 1 de octubre de 2024. La Ley N.º 10558, de octubre de 2024, lo reformó, y la Ley N.º 10650, de febrero de 2025, cambió el artículo 48 del Código de Familia. Las áreas y los artículos indican la fecha en que se consultaron las normas.' }
];
const crumbs = [{ label: 'Sobre Evelyn' }];
---
<Base pagina="AboutPage" title="Sobre Evelyn Elizondo" description="Qué procura aclarar una consulta de derecho de familia en Costa Rica con Evelyn Elizondo: vías, documentos, plazos, efectos y los límites de la publicidad profesional." crumbs={crumbs}>
  <PageHero titulo="Cómo se trabaja en derecho de *familia*" lede="Evelyn Elizondo | Derecho de Familia | Costa Rica" crumbs={crumbs} />

  <section class="chapter bg-ivory">
    <div class="wrap g12" style="row-gap:32px">
      <h2 class="statement" style="grid-column:1/-1" data-partir>Una opinión jurídica depende de los <em>hechos,</em> la prueba y la norma vigente.</h2>
      <div class="reveal" style="grid-column:7/-1" id="sobre-texto">
        <p>Una consulta de derecho de familia procura responder preguntas concretas:</p>
        <ul class="rows">
          <li>Qué vías existen y qué exige cada una</li>
          <li>Qué documentos y datos hacen falta</li>
          <li>Qué plazos pueden estar corriendo</li>
          <li>Qué efectos tiene un acuerdo o una resolución</li>
          <li>Cómo incide el interés superior de las personas menores de edad</li>
          <li>Qué aspectos son favorables y cuáles desfavorables</li>
        </ul>
        <p>Antes de solicitar una consulta, puede revisar las áreas y los artículos de este sitio para conocer la terminología y las opciones que existen en Costa Rica.</p>
        <div class="btn-row"><a class="btn" href="/agendar-consulta">Agendar una consulta</a></div>
      </div>
    </div>
  </section>

  <div data-mascara style="height:clamp(280px,44vw,640px);overflow:hidden">
    <img data-paralaje style="width:100%;height:118%;object-fit:cover" src="/assets/images/escalera-ancha.webp" srcset="/assets/images/escalera-ancha-sm.webp 700w, /assets/images/escalera-ancha.webp 1600w" sizes="100vw" alt="Escalera de piedra iluminada por luz lateral" width="1600" height="900" loading="lazy" decoding="async" />
  </div>

  <section class="chapter">
    <div class="wrap">
      <p class="eyebrow reveal">Marco general</p>
      <h2 data-partir style="margin-bottom:clamp(36px,5vw,72px)">Tres puntos de referencia</h2>
      <ul class="values">{etica.map((e, i) => <li class="reveal" style={`--retraso:${i * 0.1}s`}><h3>{e.t}</h3><p>{e.d}</p></li>)}</ul>
    </div>
  </section>

  <section class="chapter bg-ivory">
    <div class="wrap">
      <h2 data-partir style="margin-bottom:clamp(36px,5vw,72px)">Criterios generales sobre una consulta</h2>
      <ul class="values">
        {principios.map((p, i) => <li class="reveal" style={`--retraso:${(i % 3) * 0.1}s`}><h3>{p.titulo}</h3><p>{p.texto}</p><span class="values__tag">{p.etiqueta}</span></li>)}
      </ul>
    </div>
  </section>

  <PostsSection titulo="Lecturas recomendadas" posts={posts} />
  <Cta imagen="columnata" />
</Base>
<style>
  @media (max-width: 1023px) { #sobre-texto { grid-column: 1 / -1 !important; } }
</style>
