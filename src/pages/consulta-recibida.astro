---
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
// Solo se llega aquí cuando el proveedor de correo aceptó el mensaje para su entrega (303 desde /api/consulta).
// No se afirma que haya llegado al buzón ni que se haya leído.
---
<Base title="Solicitud enviada" description="Confirmación de que la solicitud de consulta se envió." noindex>
  <PageHero titulo="Solicitud enviada" lede="Su solicitud se envió para su revisión. Enviar este formulario no crea, por sí solo, una relación profesional ni detiene los plazos de un proceso. Si tiene un plazo en curso, atiéndalo sin esperar una respuesta por este medio.">
    <div class="btn-row"><a class="btn" href="/">Volver al inicio</a></div>
  </PageHero>
</Base>
