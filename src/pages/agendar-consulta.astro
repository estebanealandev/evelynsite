---
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import ConsultaForm from '../components/forms/ConsultaForm.astro';
const pasos = [
  { titulo: 'Envíe la solicitud', texto: 'Indique el tipo de asunto y escriba una descripción general de hasta 1200 caracteres. El formulario no admite documentos y no hace falta incluir detalles íntimos.' },
  { titulo: 'Revisión de la solicitud', texto: 'La solicitud se revisa para determinar si puede atenderse y cómo continuar. Enviarla no crea, por sí solo, una relación profesional ni detiene los plazos de un proceso.' },
  { titulo: 'Conversación', texto: 'Si el asunto puede atenderse, se coordina una conversación para revisar hechos, documentos y plazos, y para aclarar el alcance y las condiciones de una posible asesoría.' }
];
const crumbs = [{ label: 'Agendar una consulta' }];
---
<Base title="Agendar una consulta" description="Solicite una consulta sobre derecho de familia en Costa Rica por formulario. Revise qué ocurre después, qué datos se piden y cómo se tratan." crumbs={crumbs}>
  <PageHero titulo="Solicite una *consulta*" lede="Indique el tipo de asunto y descríbalo de forma general. La consulta permite revisar su situación y las opciones que contempla la legislación costarricense." crumbs={crumbs} />

  <section class="section" id="formulario">
    <div class="wrap g12" style="row-gap:44px">
      <aside style="grid-column:1/span 4" id="agendar-lado">
        <h2 style="font-size:var(--fs-h3);margin-bottom:16px">Qué sucede después</h2>
        <ol class="timeline">{pasos.map(s => <li><h3 style="font-size:1.35rem">{s.titulo}</h3><p style="font-size:.95rem">{s.texto}</p></li>)}</ol>
        <p style="margin-top:22px;font-size:var(--fs-small)">¿Prefiere conocer más primero? Revise las <a href="/servicios">áreas</a> o el <a href="/blog">blog</a>.</p>
      </aside>
      <div style="grid-column:6/-1" id="agendar-form">
        <p class="notice notice--urgent" role="note" style="margin-bottom:30px">Este formulario no atiende emergencias. Si usted o alguien más está en peligro, llame al 9-1-1. Para pedir medidas de protección no hace falta una consulta previa: vea <a href="/servicios/proteccion-familiar">violencia doméstica y medidas de protección</a>.</p>
        <ConsultaForm />
      </div>
    </div>
  </section>
</Base>
<style>
  @media (max-width: 1023px) { #agendar-lado, #agendar-form { grid-column: 1 / -1 !important; } #agendar-lado { order: 2; } }
</style>
