---
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import ConsultaForm from '../components/forms/ConsultaForm.astro';
const pasos = [
  { titulo: 'Cuente su consulta', texto: 'Complete el formulario con una descripción general del asunto. No es necesario adjuntar documentos ni incluir detalles íntimos.' },
  { titulo: 'Revisión de la solicitud', texto: 'La solicitud se revisa para determinar si puede atenderse y cómo continuar. Enviarla no crea, por sí solo, una relación profesional.' },
  { titulo: 'Conversación reservada', texto: 'Si corresponde, se coordina una conversación para identificar los aspectos principales de su situación y aclarar el alcance y las condiciones de una posible asesoría.' }
];
const crumbs = [{ label: 'Agendar una consulta' }];
---
<Base title="Agendar una consulta" description="Solicite una consulta sobre derecho de familia en Costa Rica mediante un formulario reservado. Revise qué esperar y cómo se tratan sus datos." crumbs={crumbs}>
  <PageHero titulo="Agende una consulta *confidencial*" lede="Cuéntenos brevemente su situación. Una consulta permite conocer su caso y las opciones que contempla la legislación costarricense." crumbs={crumbs} />

  <section class="section" id="formulario">
    <div class="wrap g12" style="row-gap:44px">
      <aside style="grid-column:1/span 4" id="agendar-lado">
        <h2 style="font-size:var(--fs-h3);margin-bottom:16px">Qué sucede después</h2>
        <ol class="timeline">{pasos.map(s => <li><h3 style="font-size:1.35rem">{s.titulo}</h3><p style="font-size:.95rem">{s.texto}</p></li>)}</ol>
        <p style="margin-top:22px;font-size:var(--fs-small)">¿Prefiere conocer más primero? Revise las <a href="/servicios">áreas</a> o el <a href="/blog">blog</a>.</p>
      </aside>
      <div style="grid-column:6/-1" id="agendar-form">
        <p class="notice notice--urgent" role="note" style="margin-bottom:30px">Este formulario no atiende emergencias. Si usted o alguien más está en peligro, llame al 9-1-1.</p>
        <ConsultaForm />
      </div>
    </div>
  </section>
</Base>
<style>
  @media (max-width: 1023px) { #agendar-lado, #agendar-form { grid-column: 1 / -1 !important; } #agendar-lado { order: 2; } }
</style>
