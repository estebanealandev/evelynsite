---
import Base from '../layouts/Base.astro';
import Cut from '../components/ui/Cut.astro';
import ConsultaForm from '../components/forms/ConsultaForm.astro';
const opciones = [
  { t: 'Cuente su consulta', s: 'Primer paso', img: 'documentos-ancho', d: 'Complete el formulario con una descripción general del asunto. No es necesario adjuntar documentos ni incluir detalles íntimos.' },
  { t: 'Revisión de la solicitud', s: 'Qué sucede después', img: 'escalera-ancha', d: 'La solicitud se revisa para determinar si puede atenderse y cómo continuar. Enviarla no crea, por sí solo, una relación profesional.' },
  { t: 'Conversación reservada', s: 'Si corresponde', img: 'lino', d: 'Se coordina una conversación para identificar los aspectos principales de su situación y aclarar el alcance y las condiciones de una posible asesoría.' }
];
---
<Base title="Agendar una consulta" description="Solicite una consulta sobre derecho de familia en Costa Rica mediante un formulario reservado. Revise qué esperar y cómo se tratan sus datos." crumbs={[{ label: 'Agendar una consulta' }]}>
  <section class="section" style="padding-block:clamp(10px,2vw,20px) clamp(36px,4vw,60px)">
    <div class="wrap media-split media-split--rev">
      <div class="offset offset--rev offset--band"><img src="/assets/images/luz-ventana-sm.webp" alt="Luz de ventana sobre un muro claro" width="700" height="438" fetchpriority="high" decoding="async" /></div>
      <div>
        <h1>Agende una consulta confidencial</h1>
        <p style="margin-top:12px">Cuéntenos brevemente su situación. La información sobre divorcios, pensiones alimentarias, guarda y crianza, interrelación familiar, bienes gananciales, unión de hecho y filiación está disponible en este sitio para ayudarle a preparar su consulta.</p>
      </div>
    </div>
  </section>
  <Cut color="ivory" flip vertex={25} />
  <section class="section bg-ivory" style="padding-top:clamp(20px,3vw,40px)">
    <div class="wrap center reveal">
      <h2>Dé el primer paso</h2>
      <p class="lede" style="margin-top:12px">Una consulta permite conocer su situación y las opciones que contempla la legislación costarricense.</p>
      <div class="vline vline--tight"></div>
    </div>
    <div class="wrap-wide option-cards" style="max-width:1100px">
      {opciones.map(o => (
        <article class="option-card reveal">
          <img src={`/assets/images/${o.img}-sm.webp`} alt="" width="700" height="438" loading="lazy" decoding="async" />
          <h3>{o.t}</h3>
          <p class="eyebrow" style="font-size:.72rem">{o.s}</p>
          <p>{o.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="formulario">
    <div class="wrap" style="max-width:820px">
      <h2 class="center">Formulario de consulta</h2>
      <p class="center" style="margin:10px 0 28px">Todos los campos son obligatorios, salvo el teléfono.</p>
      <p class="notice notice--urgent" style="margin-bottom:26px">Este formulario no atiende emergencias. Si usted o alguien más está en peligro, llame al 9-1-1.</p>
      <ConsultaForm />
    </div>
  </section>

  <Cut color="band" flip vertex={75} />
  <section class="section bg-band ghost-wrap" style="padding-block:clamp(50px,7vw,100px);overflow:hidden">
    <span class="ghost ghost--band" aria-hidden="true" style="top:clamp(40px,5vw,70px)">Hablemos</span>
    <div class="wrap center reveal">
      <h2>¿Prefiere conocer más primero?</h2>
      <div class="btn-row"><a class="btn" href="/servicios">Conocer las áreas</a></div>
    </div>
  </section>
  <section class="section bg-ivory" style="padding-block:clamp(40px,5vw,70px)">
    <div class="wrap resource-strip">
      <h2>¿Busca recursos útiles?</h2>
      <a class="btn" href="/blog">Leer el blog</a>
    </div>
  </section>
</Base>
