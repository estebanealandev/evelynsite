---
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import { site } from '../config/site';
const c = site.contact;
const hayDatos = c.address || c.phone || c.email || c.hours;
const crumbs = [{ label: 'Contacto' }];
---
<Base title="Contacto" description="Cómo solicitar una consulta de derecho de familia en Costa Rica con Evelyn Elizondo: formulario, qué conviene escribir y aviso sobre emergencias." crumbs={crumbs}>
  <PageHero titulo="Contacto para consultas de derecho de *familia*" crumbs={crumbs} />
  <section class="chapter">
    <div class="wrap g12" style="row-gap:40px">
      <div class="reveal" style="grid-column:1/span 7" id="contacto-texto">
        <p class="statement" style="font-family:var(--font-titulares);font-weight:600;letter-spacing:-.03em;font-size:clamp(1.9rem,1.5rem + 1.6vw,3rem);line-height:1.12;color:var(--color-primary)">Las solicitudes de consulta se reciben por medio del formulario.</p>
        <p style="margin-top:20px">Describa el asunto de forma general, sin documentos ni datos de personas menores de edad. Enviar el formulario no detiene los plazos de un proceso.</p>
        <div class="btn-row"><a class="btn" href="/agendar-consulta">Agendar una consulta</a></div>
      </div>
      <div class="reveal" style="grid-column:9/-1;--retraso:.1s" id="contacto-datos">
        {hayDatos && (
          <ul class="rows" style="margin-top:0">
            {c.address && <li>{c.address}</li>}
            {c.phone && <li><a href={`tel:${c.phone.replace(/[^+\d]/g, '')}`}>{c.phone}</a></li>}
            {c.email && <li><a href={`mailto:${c.email}`}>{c.email}</a></li>}
            {c.hours && <li>{c.hours}</li>}
          </ul>
        )}
        <p class="notice notice--urgent" role="note">Este canal no atiende emergencias. Si está en peligro, llame al 9-1-1.</p>
      </div>
    </div>
  </section>
</Base>
<style>
  @media (max-width: 1023px) { #contacto-texto, #contacto-datos { grid-column: 1 / -1 !important; } }
</style>
