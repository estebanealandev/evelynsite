---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import AreasList from '../../components/sections/AreasList.astro';
import Orientador from '../../components/sections/Orientador.astro';
import Cta from '../../components/sections/Cta.astro';
const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const crumbs = [{ label: 'Áreas' }];
---
<Base title="Áreas de derecho de familia en Costa Rica" description="Información sobre divorcios, pensiones alimentarias, guarda y crianza, interrelación familiar, gananciales, unión de hecho, filiación, acuerdos y protección familiar." crumbs={crumbs}>
  <PageHero titulo="Áreas de derecho de *familia*" lede="Información general según la legislación costarricense vigente." crumbs={crumbs} />
  <section class="section">
    <div class="wrap">
      <AreasList servicios={servicios} />
      <p class="notice" style="margin-top:44px">Estas páginas tienen fines informativos. Para confirmar si un asunto concreto puede atenderse, utilice el <a href="/agendar-consulta">formulario de consulta</a>.</p>
    </div>
  </section>
  <Orientador servicios={servicios} />
  <Cta />
</Base>
