---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import PostsSection from '../../components/sections/PostsSection.astro';
import Cta from '../../components/sections/Cta.astro';
import SeguridadNavegacion from '../../components/sections/SeguridadNavegacion.astro';
import { em, fechaLarga } from '../../lib/format';
import { fuentes } from '../../lib/sources';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map(s => ({ params: { slug: s.id }, props: { servicio: s } }));
}
const { servicio } = Astro.props;
const d = servicio.data;
const { Content } = await render(servicio);
const todos = await getCollection('servicios');
const relacionados = d.relacionados.map((id: string) => todos.find(s => s.id === id)).filter(Boolean);
const articulos = (await getCollection('articulos')).filter(a => a.data.servicios.includes(servicio.id));
const otros = (await getCollection('articulos')).filter(a => !a.data.servicios.includes(servicio.id));
const lecturas = [...articulos, ...otros].slice(0, 3);
const crumbs = [{ label: 'Áreas', href: '/servicios' }, { label: d.titulo }];
const secciones = [
  ['en-breve', 'En breve'],
  ['que-dice-la-ley', '¿Qué dice la ley?'],
  ['con-mas-detalle', 'Con más detalle'],
  ['cuando-asesorarse', '¿Cuándo asesorarse?'],
  ['como-es-el-tramite', '¿Cómo es el trámite?'],
  ['a-tener-presente', 'A tener presente'],
  ...(d.preguntas.length ? [['preguntas', 'Preguntas frecuentes']] : []),
  ...(d.siguientes ? [['siguientes', d.siguientes.titulo]] : []),
  ['fuentes', 'Fuentes']
];
---
<Base title={d.metaTitulo} description={d.metaDescripcion} crumbs={crumbs} lectura salidaRapida={servicio.id === 'proteccion-familiar'}>
  <PageHero titulo={d.hero.titulo} lede={d.hero.entrada} eyebrow={`Área de práctica ${String(d.orden).padStart(2, '0')}`} crumbs={crumbs} />
  {d.aviso && <div class="wrap" style="margin-top:28px"><p class="notice notice--urgent" role="note">{d.aviso}</p></div>}
  {servicio.id === 'proteccion-familiar' && <div class="wrap" style="margin-top:12px"><SeguridadNavegacion /></div>}

  <div class="wrap g12 read">
    <details class="toc" open data-toc>
      <summary>En esta página</summary>
      <p class="toc__label">En esta página</p>
      <nav aria-label="En esta página">
        <ol>{secciones.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol>
      </nav>
    </details>

    <article class="read__body">
      <section class="read__section" id="en-breve">
        <h2 set:html={em(d.intro.titulo)} />
        <p class="read__lede">{d.intro.parrafo}</p>
        <ul class="rows">{d.intro.lista.map((l: string) => <li>{l}</li>)}</ul>
        <p>{d.intro.cierre}</p>
      </section>

      <section class="read__section" id="que-dice-la-ley">
        <h2>{d.aspectos.titulo}</h2>
        <p class="read__lede">{d.aspectos.entrada}</p>
        {d.aspectos.items.map((a: { titulo: string; resumen: string; detalle: string }) => (
          <div class="read__item">
            <h3>{a.titulo}</h3>
            <p class="read__resumen">{a.resumen}</p>
            <p>{a.detalle}</p>
          </div>
        ))}
      </section>

      <section class="read__section prose" id="con-mas-detalle"><Content /></section>

      <section class="read__section" id="cuando-asesorarse">
        <h2>{d.situaciones.titulo}</h2>
        <ul class="rows rows--cols">{d.situaciones.items.map((s: string) => <li>{s}</li>)}</ul>
        <div class="btn-row"><a class="btn" href="/agendar-consulta">Agendar una consulta</a></div>
      </section>

      <section class="read__section" id="como-es-el-tramite">
        <h2 set:html={em(d.procedimiento.titulo)} />
        <p class="read__lede">{d.procedimiento.entrada}</p>
        <ol class="timeline" style="margin-top:26px">
          {d.procedimiento.pasos.map((s: { titulo: string; texto: string }) => <li><h3>{s.titulo}</h3><p>{s.texto}</p></li>)}
        </ol>
      </section>

      <section class="read__section" id="a-tener-presente">
        <h2 set:html={em(d.importante.titulo)} />
        <p class="read__lede">{d.importante.entrada}</p>
        <h3 style="margin-top:22px">{d.importante.subtitulo}</h3>
        <ul class="rows">{d.importante.items.map((i: string) => <li>{i}</li>)}</ul>
        <p>{d.importante.cierre}</p>
      </section>

      {d.preguntas.length > 0 && <section class="read__section" id="preguntas">
        <h2 style="margin-bottom:26px">Preguntas frecuentes</h2>
        <div class="faq">
          {d.preguntas.map((q: { p: string; r: string }) => <details><summary>{q.p}</summary><div><p>{q.r}</p></div></details>)}
        </div>
      </section>}

      {d.siguientes && (
        <section class="read__section" id="siguientes">
          <h2>{d.siguientes.titulo}</h2>
          <ul class="rows">{d.siguientes.items.map((i: string) => <li>{i}</li>)}</ul>
        </section>
      )}

      <section class="read__section sources" id="fuentes">
        <h2>Fuentes normativas</h2>
        <ul>
          {d.fuentes.map((f: { ref: keyof typeof fuentes; detalle: string }) => (
            <li><a href={fuentes[f.ref].url} rel="noopener noreferrer" target="_blank">{fuentes[f.ref].nombre}</a>: {f.detalle}.</li>
          ))}
        </ul>
        <p style="margin-top:10px">Normativa consultada el {fechaLarga(site.legalVerifiedAt)}. Esta información es general y no sustituye la asesoría individualizada. Su aplicación depende de los hechos y de la prueba de cada caso.</p>
      </section>

      <section style="margin-top:44px">
        <h2 style="margin-bottom:14px;font-size:var(--fs-h3)">Temas relacionados</h2>
        <ul class="tag-list">{relacionados.map((r: any) => <li><a href={`/servicios/${r.id}`}>{r.data.titulo}</a></li>)}</ul>
      </section>
    </article>
  </div>

  <PostsSection titulo="Para seguir leyendo" posts={lecturas} bg="bg-ivory" />
  <Cta imagen={d.imagenAncha} />
</Base>
