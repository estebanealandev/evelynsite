---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/ui/PostCard.astro';
import Cta from '../../components/sections/Cta.astro';
import { slugify } from '../../lib/format';

const articulos = await getCollection('articulos');
const destacados = articulos.filter(a => a.data.destacado).slice(0, 4);
const grupos = [
  { t: 'Divorcio y bienes', c: ['Divorcio', 'Bienes gananciales'] },
  { t: 'Hijas e hijos', c: ['Guarda y crianza', 'Interrelación familiar', 'Filiación'] },
  { t: 'Pensiones y unión de hecho', c: ['Pensiones alimentarias', 'Unión de hecho'] },
  { t: 'Procesos y protección', c: ['Procesos de familia', 'Protección familiar'] }
].map(g => ({ ...g, posts: articulos.filter(a => g.c.includes(a.data.categoria)).slice(0, 4) }));
const categorias = [...new Set(articulos.map(a => a.data.categoria))];
---
<Base title="Blog de derecho de familia en Costa Rica" description="Artículos informativos sobre divorcio, pensiones alimentarias, guarda y crianza, gananciales, unión de hecho y procesos de familia en Costa Rica." crumbs={[{ label: 'Blog' }]}>
  <section class="hero-blue on-dark">
    <img src="/assets/images/documentos-ancho.webp" alt="" width="1600" height="1000" decoding="async" />
    <div>
      <h1>Biblioteca de derecho de familia</h1>
      <p>Información clara sobre la legislación costarricense</p>
      <ul class="hero-links">
        {categorias.map(c => <li><a href={`/blog/categoria/${slugify(c)}`}>{c}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="bg-band" style="padding-bottom:clamp(44px,5vw,70px)">
    <div class="wrap" style="position:relative">
      <h2 style="padding-top:clamp(44px,5vw,70px);margin-bottom:28px">Lecturas destacadas</h2>
      <div class="post-grid post-grid--4" style="margin-top:0">{destacados.map(p => <PostCard post={p} />)}</div>
    </div>
  </section>

  {grupos.map((g, i) => {
    const dark = i === 1;
    return (
      <section class:list={['section', dark ? 'bg-image-dark on-dark' : i === 2 ? 'bg-ivory' : 'bg-white']}>
        {dark && <img src="/assets/images/lino.webp" alt="" width="1600" height="1000" loading="lazy" decoding="async" />}
        <div class="wrap">
          <h2 style="font-size:var(--fs-h3)">{g.t}</h2>
          <div class="post-grid post-grid--4" style="margin-top:20px">{g.posts.map(p => <PostCard post={p} />)}</div>
        </div>
      </section>
    );
  })}
  <Cta />
</Base>
