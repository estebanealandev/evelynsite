---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import PostCard from '../../components/ui/PostCard.astro';
import Cta from '../../components/sections/Cta.astro';
import { slugify } from '../../lib/format';

const articulos = await getCollection('articulos');
const principal = articulos.find(a => a.id === 'cambios-codigo-procesal-familia') ?? articulos[0];
const resto = articulos.filter(a => a.id !== principal.id);
const categorias = [...new Set(articulos.map(a => a.data.categoria))].sort();
const crumbs = [{ label: 'Blog' }];
---
<Base title="Blog de derecho de familia en Costa Rica" description="Artículos informativos sobre divorcio, pensiones alimentarias, guarda y crianza, gananciales, unión de hecho y procesos de familia en Costa Rica." crumbs={crumbs}>
  <PageHero titulo="Artículos de derecho de *familia*" lede="Preguntas concretas sobre la legislación costarricense, con las normas consultadas." crumbs={crumbs} />

  <section class="section" style="padding-bottom:0">
    <div class="wrap">
      <a class="featured" href={`/blog/${principal.id}`}>
        <div class="featured__img" data-mascara><img src={`/assets/images/${principal.data.imagen}.webp`} srcset={`/assets/images/${principal.data.imagen}-sm.webp 700w, /assets/images/${principal.data.imagen}.webp 1400w`} sizes="(max-width: 767px) 100vw, 58vw" alt="" width="1400" height="875" fetchpriority="high" decoding="async" /></div>
        <div class="featured__text reveal">
          <span class="post-card__cat" style="margin:0">Artículo destacado · {principal.data.categoria}</span>
          <h2>{principal.data.titulo}</h2>
          <p>{principal.data.resumen}</p>
        </div>
      </a>
    </div>
  </section>

  <section class="section" data-filtros>
    <div class="wrap">
      <div class="filters">
        <ul class="chips" aria-label="Filtrar por categoría">
          <li><button class="chip" type="button" data-cat-btn="" aria-pressed="true" hidden>Todas</button></li>
          {categorias.map(c => <li><a class="chip" href={`/blog/categoria/${slugify(c)}`} data-cat-btn={c}>{c}</a></li>)}
        </ul>
        <div class="search" hidden data-buscador>
          <label class="visually-hidden" for="buscar">Buscar artículos</label>
          <input id="buscar" type="search" placeholder="Buscar artículos" autocomplete="off" />
        </div>
      </div>
      <p class="resultado" role="status" aria-live="polite" data-resultado></p>
      <div class="post-grid post-grid--3" style="margin-top:20px">
        {resto.map(p => <PostCard post={p} filtro />)}
      </div>
    </div>
  </section>
  <Cta />
</Base>
