---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import PostsSection from '../../components/sections/PostsSection.astro';
import SeguridadNavegacion from '../../components/sections/SeguridadNavegacion.astro';
import { fechaLarga, slugify } from '../../lib/format';
import { fuentes } from '../../lib/sources';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  return articulos.map((a, i) => ({
    params: { slug: a.id },
    props: { articulo: a, anterior: articulos[i - 1] ?? null, siguiente: articulos[i + 1] ?? null, todos: articulos }
  }));
}
const { articulo, anterior, siguiente, todos } = Astro.props;
const d = articulo.data;
const { Content, headings } = await render(articulo);
const indice = headings.filter(h => h.depth === 2);
const servicios = await getCollection('servicios');
const vinculados = d.servicios.map((id: string) => servicios.find(s => s.id === id)).filter(Boolean);
const relacionados = todos
  .filter((a: any) => a.id !== articulo.id)
  .sort((a: any, b: any) => Number(b.data.categoria === d.categoria) - Number(a.data.categoria === d.categoria))
  .slice(0, 3);
const url = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titulo,
  description: d.metaDescripcion,
  datePublished: d.fecha,
  dateModified: site.legalVerifiedAt,
  inLanguage: 'es-CR',
  image: new URL(`/assets/images/${d.imagen}.webp`, Astro.site).href,
  mainEntityOfPage: url,
  // La autoría de una persona solo se declara cuando está confirmada.
  author: site.autora.verificada
    ? { '@type': 'Person', name: site.autora.nombre, ...(site.autora.perfil ? { url: site.autora.perfil, sameAs: [site.autora.perfil] } : {}), ...(site.autora.credencial ? { hasCredential: { '@type': 'EducationalOccupationalCredential', name: site.autora.credencial } } : {}) }
    : { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name }
};
const crumbs = [{ label: 'Blog', href: '/blog' }, { label: d.categoria, href: `/blog/categoria/${slugify(d.categoria)}` }, { label: d.titulo }];
---
<Base title={d.metaTitulo} description={d.metaDescripcion} type="article" crumbs={crumbs} jsonLd={[schema]} image={`/assets/images/${d.imagen}.webp`} lectura salidaRapida={articulo.id === 'proteccion-juridica-violencia-domestica'}>
  <PageHero titulo={d.titulo} crumbs={crumbs}>
    <p slot="antes" class="post-meta"><a href={`/blog/categoria/${slugify(d.categoria)}`}>{d.categoria}</a> · {fechaLarga(d.fecha)}</p>
  </PageHero>
  {articulo.id === 'proteccion-juridica-violencia-domestica' && <div class="wrap" style="margin-top:12px"><SeguridadNavegacion /></div>}
  <figure class="article-img" style="margin-block:clamp(28px,4vw,56px) 0"><div data-mascara><img src={`/assets/images/${d.imagen}.webp`} srcset={`/assets/images/${d.imagen}-sm.webp 700w, /assets/images/${d.imagen}.webp 1400w`} sizes="100vw" alt={d.alt} width="1400" height="600" fetchpriority="high" decoding="async" /></div></figure>

  <div class="wrap g12 read">
    <details class="toc" open data-toc>
      <summary>En este artículo</summary>
      <p class="toc__label">En este artículo</p>
      <nav aria-label="En este artículo">
        <ol>{indice.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    </details>
    <article class="read__body">
      <div class="prose"><Content /></div>

      <div class="sources" style="margin-top:44px;padding-top:22px;border-top:1px solid var(--line-on-light)">
        <h2>Fuentes normativas</h2>
        <ul>
          {d.fuentes.map((f: { ref: keyof typeof fuentes; detalle: string }) => (
            <li><a href={fuentes[f.ref].url} rel="noopener noreferrer" target="_blank">{fuentes[f.ref].nombre}</a>: {f.detalle}.</li>
          ))}
        </ul>
        <p style="margin-top:10px"><strong>Fecha de revisión de la normativa:</strong> {fechaLarga(site.legalVerifiedAt)}. Este artículo es informativo y no sustituye la asesoría individualizada.</p>
      </div>

      <div style="margin-top:36px">
        <p class="eyebrow" style="margin-bottom:10px">Áreas relacionadas</p>
        <ul class="tag-list">{vinculados.map((s: any) => <li><a href={`/servicios/${s.id}`}>{s.data.titulo}</a></li>)}</ul>
        <p class="eyebrow" style="margin:22px 0 10px">Etiquetas</p>
        <ul class="tag-list">{d.etiquetas.map((t: string) => <li><a href={`/blog/etiqueta/${slugify(t)}`}>{t}</a></li>)}</ul>
        <div class="btn-row"><a class="btn" href="/agendar-consulta">Agendar una consulta</a></div>
      </div>

      <nav class="post-nav" aria-label="Artículos anterior y siguiente">
        <div>{anterior && <a href={`/blog/${anterior.id}`}><small>Anterior</small>{anterior.data.titulo}</a>}</div>
        <div>{siguiente && <a href={`/blog/${siguiente.id}`}><small>Siguiente</small>{siguiente.data.titulo}</a>}</div>
      </nav>
    </article>
  </div>
  <PostsSection titulo="Artículos relacionados" posts={relacionados} bg="bg-ivory" />
</Base>
