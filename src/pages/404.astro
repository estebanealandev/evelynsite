---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import PostsSection from '../components/sections/PostsSection.astro';
const posts = (await getCollection('articulos')).filter(a => a.data.destacado).slice(0, 3);
---
<Base title="Página no encontrada" description="La página solicitada no existe." noindex>
  <PageHero titulo="404: página no encontrada" lede="La página que busca no existe o cambió de dirección.">
    <div class="btn-row">
      <a class="btn" href="/">Volver al inicio</a>
      <a class="btn btn-outline" href="/servicios">Ver las áreas</a>
    </div>
  </PageHero>
  <PostsSection titulo="Recursos sobre derecho de familia" posts={posts} />
</Base>
