---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { createHash } from 'node:crypto';
import { site } from '../config/site';
import { robotsDePagina } from '../config/indexacion.mjs';
import { grafo } from '../lib/seo/grafo';

const {
  title,
  description,
  image = '/assets/brand/og-default.jpg',
  imageAlt = 'Evelyn Elizondo, Derecho de Familia, Costa Rica',
  type = 'website',
  noindex = false,
  revision,
  pagina = 'WebPage',
  tema = [],
  revisadaPor,
  revisadaEl,
  publicado,
  actualizado,
  jsonLd = [],
  crumbs = [],
  lectura = false,
  turnstile = false,
  salidaRapida = Astro.url.pathname !== '/'
} = Astro.props;
// La marca se añade solo si cabe: los títulos largos se truncan en los resultados y la marca ya va en og:site_name.
const conMarca = `${title} | ${site.name}`;
const fullTitle = title.includes(site.name) || conMarca.length > 65 ? title : conMarca;
// Canonical absoluto, sin barra final y sin parámetros: una sola URL por página.
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;
// `noindex` marca páginas que no se indexan nunca; `revision` deja fuera el contenido jurídico sin aprobar.
const robots = robotsDePagina({ indexable: site.indexable, excluida: noindex, revision });
const ogImage = new URL(image, Astro.site).href;
const datos = grafo({
  base: Astro.site!,
  url: canonical,
  titulo: fullTitle,
  descripcion: description,
  tipo: pagina,
  imagen: image,
  migas: crumbs,
  tema,
  revisadaPor,
  revisadaEl,
  nodos: jsonLd
});
// Único script en línea: debe correr antes de pintar. La política lo admite por su huella y bloquea cualquier otro.
const inicial = "document.documentElement.classList.add('js');try{if(localStorage.getItem('movimiento')==='pausado')document.documentElement.dataset.movimiento='pausado'}catch{}";
const huella = createHash('sha256').update(inicial).digest('base64');
// Turnstile es la única excepción a los recursos propios, y solo en la página del formulario.
const cf = turnstile && site.turnstile ? ' https://challenges.cloudflare.com' : '';
const csp = `default-src 'self'; script-src 'self' 'sha256-${huella}'${cf}; frame-src 'self'${cf}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'`;
---
<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="same-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="geo.region" content="CR" />
    <meta name="theme-color" content="#1b1a18" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && publicado && <meta property="article:published_time" content={publicado} />}
    {type === 'article' && (actualizado ?? publicado) && <meta property="article:modified_time" content={actualizado ?? publicado} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/assets/fonts/schibsted-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={inicial} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(datos).replace(/</g, '\\u003c')} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {salidaRapida && <a class="salida" href="https://www.google.com/" rel="noreferrer" data-salida>Salir rápido</a>}
    {lectura && <div class="progress" data-progreso aria-hidden="true"></div>}
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
    <script is:inline src="/assets/js/site.js" defer></script>
  </body>
</html>
