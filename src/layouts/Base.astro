---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { createHash } from 'node:crypto';
import { site } from '../config/site';

const { title, description, image = '/assets/brand/og-default.jpg', type = 'website', noindex = false, jsonLd = [], crumbs = [], lectura = false, salidaRapida = Astro.url.pathname !== '/' } = Astro.props;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;
const robots = noindex || !site.indexable ? 'noindex, nofollow' : 'index, follow';
const ogImage = new URL(image, Astro.site).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  '@id': new URL('/#organizacion', Astro.site).href,
  name: site.name,
  description: site.description,
  url: new URL('/', Astro.site).href,
  logo: new URL('/assets/brand/evelyn-elizondo-monogram.png', Astro.site).href,
  areaServed: { '@type': 'Country', name: 'Costa Rica' },
  knowsLanguage: 'es-CR',
  ...(site.contact.phone ? { telephone: site.contact.phone } : {}),
  ...(site.contact.email ? { email: site.contact.email } : {})
};
const breadcrumb = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ label: 'Inicio', href: '/' }, ...crumbs].map((c: any, i: number) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        item: new URL(c.href ?? Astro.url.pathname, Astro.site).href
      }))
    }
  : null;
const schemas = [org, breadcrumb, ...jsonLd].filter(Boolean);
// Único script en línea: debe correr antes de pintar. La política lo admite por su huella y bloquea cualquier otro.
const inicial = "document.documentElement.classList.add('js');try{if(localStorage.getItem('movimiento')==='pausado')document.documentElement.dataset.movimiento='pausado'}catch{}";
const huella = createHash('sha256').update(inicial).digest('base64');
const csp = `default-src 'self'; script-src 'self' 'sha256-${huella}'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'`;
---
<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="same-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="geo.region" content="CR" />
    <meta name="theme-color" content="#1b1a18" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Evelyn Elizondo, Derecho de Familia, Costa Rica" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/assets/fonts/schibsted-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={inicial} />
    {schemas.map(s => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {salidaRapida && <a class="salida" href="https://www.google.com/" rel="noreferrer" data-salida>Salir rápido</a>}
    {lectura && <div class="progress" data-progreso aria-hidden="true"></div>}
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
    <script is:inline src="/assets/js/site.js" defer></script>
  </body>
</html>
