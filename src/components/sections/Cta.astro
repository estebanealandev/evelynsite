---
import { em } from '../../lib/format';
const { titulo = 'Lo que aplica a un caso concreto se determina con sus hechos y *documentos.*', imagen = 'umbral', texto = 'Agendar una consulta', href = '/agendar-consulta' } = Astro.props;
---
<section class="cta on-dark">
  <img src={`/assets/images/${imagen}.webp`} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
  <div class="wrap cta__inner">
    <h2 data-partir set:html={em(titulo)} />
    <a class="btn" href={href}>{texto}</a>
  </div>
</section>
