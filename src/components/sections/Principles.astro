---
// Ocupa el lugar funcional de los testimonios: no hay testimonios autorizados.
import Carousel from '../ui/Carousel.astro';
import { principios } from '../../lib/institucional';
---
<section class="bg-band" style="padding-block:clamp(30px,4vw,56px) clamp(56px,7vw,100px)">
  <div class="wrap-wide">
    <h2 style="margin-bottom:34px">Principios que guían la atención</h2>
    <Carousel label="Principios de atención">
      {principios.map(p => (
        <article class="carousel__slide quote-card">
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
          <span class="quote-card__tag">{p.etiqueta}</span>
        </article>
      ))}
    </Carousel>
  </div>
</section>
