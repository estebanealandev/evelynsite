---
import PostCard from '../ui/PostCard.astro';
const { titulo, entrada, posts, bg = 'bg-white' } = Astro.props;
---
<section class={`section ${bg}`}>
  <div class="wrap">
    <h2 class="reveal">{titulo}</h2>
    {entrada && <p class="reveal" style="margin-top:12px;max-width:42em">{entrada}</p>}
    <div class="post-grid post-grid--3">{posts.map((p: any, i: number) => <div class="reveal" style={`--retraso:${i * 0.08}s`}><PostCard post={p} /></div>)}</div>
  </div>
</section>
