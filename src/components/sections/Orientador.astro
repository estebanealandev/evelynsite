---
// Sin JavaScript se muestra la lista completa de áreas; con JavaScript, una pregunta a la vez.
import { getCollection } from 'astro:content';
import { AVISO_RIESGO, inicio, preguntas } from '../../lib/orientador';
const { servicios } = Astro.props;
const fichas = await getCollection('fichas');
const areas = Object.fromEntries(servicios.map((s: any) => [s.id, { titulo: s.data.titulo, resumen: s.data.resumen }]));
const guias = Object.fromEntries(fichas.map((f: any) => [f.id, { titulo: f.data.titulo, resumen: f.data.resumen }]));
// Lo relativo a un riesgo va primero en la lista sin JavaScript.
const ordenados = [...servicios].sort((a: any, b: any) => Number(b.id === 'proteccion-familiar') - Number(a.id === 'proteccion-familiar'));
const datos = JSON.stringify({ inicio, preguntas, areas, guias, aviso: AVISO_RIESGO });
---
<section class="section bg-ivory" id="por-donde-empiezo">
  <div class="wrap guia" data-guia>
    <div class="guia__intro">
      <p class="eyebrow">Orientador</p>
      <h2>¿Por dónde empiezo?</h2>
      <p style="margin-top:16px;max-width:30em">Una guía para encontrar qué leer. Señala un tema, no una conclusión: qué vía corresponde depende de hechos que esta guía no pregunta. No es asesoría jurídica, y lo que elija no se guarda ni se envía.</p>
    </div>
    <div class="guia__panel" data-guia-panel>
      <p class="notice notice--urgent">{AVISO_RIESGO}</p>
      <p class="guia__q" style="margin-top:20px">¿Sobre qué busca información?</p>
      <ul class="guia__ops">
        {ordenados.map((s: any) => <li><a class="guia__op" href={`/servicios/${s.id}`}>{s.data.titulo}</a></li>)}
      </ul>
    </div>
    <script type="application/json" data-guia-datos set:html={datos.replace(/</g, '\\u003c')} />
  </div>
</section>
