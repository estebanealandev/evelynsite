---
// Sin JavaScript se muestra la lista completa de situaciones; con JavaScript, una pregunta a la vez.
import { inicio, preguntas } from '../../lib/orientador';
const { servicios } = Astro.props;
const areas = Object.fromEntries(servicios.map((s: any) => [s.id, { titulo: s.data.titulo, resumen: s.data.resumen }]));
const datos = JSON.stringify({ inicio, preguntas, areas });
---
<section class="section bg-ivory" id="por-donde-empiezo">
  <div class="wrap guia" data-guia>
    <div class="guia__intro">
      <p class="eyebrow">Orientador</p>
      <h2>¿Por dónde empiezo?</h2>
      <p style="margin-top:16px;max-width:30em">Responda hasta dos preguntas para llegar a la información que puede servirle. No es asesoría jurídica y sus respuestas no se guardan ni se envían.</p>
    </div>
    <div class="guia__panel" data-guia-panel aria-live="polite">
      <p class="guia__q">¿Qué le trae hoy?</p>
      <ul class="guia__ops">
        {servicios.map((s: any) => <li><a class="guia__op" href={`/servicios/${s.id}`}>{s.data.titulo}</a></li>)}
      </ul>
    </div>
    <script type="application/json" data-guia-datos set:html={datos.replace(/</g, '\\u003c')} />
  </div>
</section>
