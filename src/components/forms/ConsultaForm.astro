---
// Con JavaScript se presenta paso a paso; sin él, todos los campos quedan visibles y el envío funciona igual.
import { consultaTipos } from '../../config/site';
---
<form class="form" action="/api/consulta" method="post" data-ajax data-pasos novalidate>
  <div class="pasos" aria-hidden="true"><span data-pasos-texto>Paso 1 de 3</span><span class="pasos__barra"><i></i></span></div>

  <fieldset data-paso>
    <legend>¿Sobre qué es su consulta?</legend>
    <div class="opciones" role="radiogroup" aria-describedby="e-tipo">
      {consultaTipos.map((t, i) => (
        <label class="opcion">
          <input type="radio" name="tipo" value={t} required data-msg="Seleccione el tipo de consulta." id={`c-tipo-${i}`} />
          <span>{t}</span>
        </label>
      ))}
    </div>
    <span class="field__error" id="e-tipo" data-error="tipo"></span>
  </fieldset>

  <fieldset data-paso>
    <legend>Indique el asunto en pocas líneas</legend>
    <div class="field">
      <label for="c-mensaje">Mensaje</label>
      <textarea id="c-mensaje" name="mensaje" autocomplete="off" required minlength="20" maxlength="1200" data-msg="Indique brevemente el asunto (mínimo 20 caracteres)." aria-describedby="h-mensaje e-mensaje"></textarea>
      <span class="field__hint" id="h-mensaje">Basta una descripción general. No incluya nombres de personas menores de edad, números de cédula o de expediente, datos de salud ni detalles íntimos. Esa información se trata después, en un espacio reservado.</span>
      <span class="field__error" id="e-mensaje" data-error="mensaje"></span>
    </div>
  </fieldset>

  <fieldset data-paso>
    <legend>Datos para responderle</legend>
    <div class="field">
      <label for="c-nombre">Nombre</label>
      <input id="c-nombre" name="nombre" type="text" autocomplete="name" required minlength="2" maxlength="120" data-msg="Indique su nombre." aria-describedby="e-nombre" />
      <span class="field__error" id="e-nombre" data-error="nombre"></span>
    </div>
    <p class="field__hint" id="h-seguro">Si otra persona puede leer su correo o revisar su teléfono, indique un medio que solo usted use.</p>
    <div class="form__row">
      <div class="field">
        <label for="c-correo">Correo electrónico</label>
        <input id="c-correo" name="correo" type="email" autocomplete="email" required maxlength="200" data-msg="Indique un correo electrónico válido." aria-describedby="h-seguro e-correo" />
        <span class="field__error" id="e-correo" data-error="correo"></span>
      </div>
      <div class="field">
        <label for="c-telefono">Teléfono (opcional)</label>
        <input id="c-telefono" name="telefono" type="tel" autocomplete="tel" maxlength="25" pattern="[+()\d\s.\-]{8,20}" data-msg="Indique un teléfono válido o deje el campo vacío." aria-describedby="h-seguro e-telefono" />
        <span class="field__error" id="e-telefono" data-error="telefono"></span>
      </div>
    </div>
    <div class="hp" aria-hidden="true">
      <label for="c-sitio">No complete este campo</label>
      <input id="c-sitio" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
      <input name="iniciado" type="hidden" value="" />
    </div>
    <div class="field">
      <label class="check" for="c-consentimiento">
        <input id="c-consentimiento" name="consentimiento" type="checkbox" required data-msg="Para enviar la solicitud, debe autorizar el tratamiento de estos datos." aria-describedby="e-consentimiento" />
        <span>Autorizo el tratamiento de mis datos personales para atender esta solicitud, según la <a href="/politica-de-privacidad">política de privacidad</a>. Entiendo que enviar este formulario no crea, por sí solo, una relación profesional.</span>
      </label>
      <span class="field__error" id="e-consentimiento" data-error="consentimiento"></span>
    </div>
  </fieldset>

  <div class="form__status" role="status" aria-live="polite"></div>
  <div class="form__nav">
    <button class="btn btn-outline" type="button" data-atras hidden>Atrás</button>
    <button class="btn" type="button" data-siguiente>Continuar</button>
    <button class="btn" type="submit" data-enviar>Enviar solicitud</button>
  </div>
</form>
