---
const { label, class: cls = '' } = Astro.props;
const flecha = (izq: boolean) => izq ? 'M36 7H2M2 7l6-6M2 7l6 6' : 'M0 7h34M34 7l-6-6M34 7l-6 6';
---
<div class={`carousel ${cls}`} data-carousel role="group" aria-roledescription="carrusel" aria-label={label}>
  <div class="carousel__track" tabindex="0"><slot /></div>
  <div class="carousel__nav">
    <button type="button" class="carousel__btn carousel__btn--prev" data-prev aria-label="Anterior"><svg viewBox="0 0 36 14" fill="none" stroke="currentColor" aria-hidden="true"><path d={flecha(true)}></path></svg></button>
    <button type="button" class="carousel__btn carousel__btn--next" data-next aria-label="Siguiente"><svg viewBox="0 0 36 14" fill="none" stroke="currentColor" aria-hidden="true"><path d={flecha(false)}></path></svg></button>
  </div>
</div>
