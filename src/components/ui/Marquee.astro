---
// Marquesina continua. La lista se repite para el bucle y la copia queda oculta a lectores de pantalla.
const { items, dark = false, label } = Astro.props;
const grupos = [0, 1, 2];
---
<section class:list={['marquee', { 'marquee--dark': dark }]} aria-label={label}>
  {grupos.map(g => (
    <div class="marquee__track" aria-hidden={g > 0 ? 'true' : undefined}>
      {items.map((t: string) => (
        <>
          <span class="marquee__item">{t}</span>
          <span class="marquee__dot" aria-hidden="true"></span>
        </>
      ))}
    </div>
  ))}
</section>
