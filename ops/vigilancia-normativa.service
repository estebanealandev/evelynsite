[Unit]
Description=Vigilancia normativa del sitio Evelyn Elizondo
After=network-online.target

[Service]
Type=oneshot
# Ajustar la ruta al repositorio. Cualquier salida distinta de 0 deja la unidad en estado fallido: 1 norma sin
# comprobar, 2 cambios, 3 ambos. Conviene añadir OnFailure= con el aviso que se use (correo u otro).
WorkingDirectory=/ruta/al/repositorio
ExecStart=/usr/bin/npm run normas:vigilar
