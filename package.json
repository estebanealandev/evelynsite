{
  "name": "evelyn-elizondo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio web de Evelyn Elizondo, Derecho de Familia, Costa Rica",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:cf": "DESTINO=cloudflare PUBLIC_SITE_URL=https://evelynelizondo.com astro build",
    "deploy": "npm run build:cf && wrangler deploy",
    "start": "NODE_ENV=production node --env-file-if-exists=.env scripts/servidor.mjs",
    "check": "astro check",
    "brand": "node scripts/instalar-marca.mjs",
    "art": "node scripts/generate-art.mjs",
    "test": "playwright test",
    "test:cf": "SERVIDOR=cloudflare playwright test",
    "test:visual": "node scripts/compare-structure.mjs",
    "capture": "node scripts/capture-phase.mjs",
    "poster": "node scripts/generate-tree-poster.mjs",
    "audit:identity": "node scripts/audit-identity.mjs",
    "normas:descargar": "node scripts/normas/descargar.mjs",
    "normas:verificar": "node scripts/normas/verificar.mjs",
    "normas:vigilar": "node scripts/normas/vigilar.mjs",
    "test:navegadores": "NAVEGADORES=todos playwright test --project=firefox --project=webkit --project=webkit-movil"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "astro": "^7.4.5",
    "nodemailer": "^10.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.6",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@types/three": "^0.187.0",
    "sharp": "^0.35.5",
    "smtp-server": "^3.21.3",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.0",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.158.0",
    "yaml": "^2.9.1"
  },
  "imports": {
    "#plataforma": "./src/lib/plataforma.ts"
  }
}
