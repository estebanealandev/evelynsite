# ---- Sitio ----
# URL pública definitiva, sin barra final. Se usa en canonical, sitemap y Open Graph.
PUBLIC_SITE_URL=https://www.ejemplo.cr

# Mantener en false hasta completar la revisión profesional y los datos pendientes.
# Con false: noindex en todas las páginas y robots.txt bloquea el rastreo.
PUBLIC_SITE_READY=false

# ---- Datos de contacto (dejar vacío si no están confirmados; la interfaz los oculta) ----
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_ADDRESS=
PUBLIC_CONTACT_HOURS=

# ---- Datos del responsable de la base de datos (política de privacidad, Ley 8968) ----
PUBLIC_DATA_CONTROLLER=
PUBLIC_DATA_CONTROLLER_ID=
PUBLIC_PRIVACY_EMAIL=
# Proveedores reales de correo y alojamiento.
PUBLIC_PRIVACY_PROVIDERS=
# Plazo real de conservación de las solicitudes recibidas.
PUBLIC_PRIVACY_RETENTION=
# Si hay almacenamiento fuera de Costa Rica, indicar dónde; si no, indicarlo.
PUBLIC_PRIVACY_TRANSFERS=

# ---- Envío de formularios ----
# smtp     = envío real.
# outbox   = guarda en var/outbox (solo desarrollo y pruebas; se rechaza en producción).
# disabled = el formulario informa que no puede procesar la solicitud (valor por defecto).
MAIL_MODE=disabled
MAIL_TO=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Acuse de recibo a la persona remitente (no repite el contenido del mensaje).
MAIL_SEND_ACK=false

# ---- Seguridad ----
# Activar solo detrás de un proxy de confianza que defina X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10
